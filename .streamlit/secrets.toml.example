# Скопіюй у .streamlit/secrets.toml (локально) або додай [auth_users] у Streamlit Cloud → Secrets.

[auth_users]
manager = "$2b$12$OtHNnmJ3aqcYw9js8y474.xxI8x3MvMufWDtlXQsUtgS6eTk7KJq."

# --- Укрпошта (приклад ключів; розкоментуй і підстав свої значення) ---
# UP_BEARER_TOKEN = ""
# UP_USER_TOKEN = ""
# UP_UUID = ""
# UP_UUID_SAND = ""
# UP_COUNTERPARTY_TOKEN = ""
# UP_TRACKING_TOKEN = ""
# UUID відправника з кабінету eCom — підставляється в майстер «УП ТТН», якщо не вводиш вручну
# UP_SENDER_UUID = ""
# UP_SENDER_ADDRESS_ID = ""
# Блок «Відправник» у формі УП ТТН (лише відображення)
# UP_SENDER_NAME = "ФОП …"
# UP_SENDER_ADDRESS = "78301, …"
# UP_SENDER_BRANCH_INDEX = "78301"
# Власне посилання на оформлення «стандарт» у кабінеті (з адресного рядка браузера після входу)
# UP_CABINET_URL = "https://ok.ukrposhta.ua/ua/lk_old/standart/add/<твій-uuid>#/know-index"
